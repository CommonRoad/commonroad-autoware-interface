digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
MainBehaviorTree [label=MainBehaviorTree, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
BehaviorModules [label="⚡ BehaviorModules\nSuccessOnAll", shape=parallelogram, style=filled, fillcolor=gold, fontsize=9, fontcolor=black];
MainBehaviorTree -> BehaviorModules;
TrafficLightModule [label=TrafficLightModule, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
BehaviorModules -> TrafficLightModule;
TrafficLightUpdate [label=TrafficLightUpdate, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
TrafficLightModule -> TrafficLightUpdate;
CheckForTrafficLights [label=CheckForTrafficLights, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
TrafficLightModule -> CheckForTrafficLights;
TrafficLightOutOfRangeCondition [label=TrafficLightOutOfRangeCondition, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
CheckForTrafficLights -> TrafficLightOutOfRangeCondition;
TrafficLightHandling [label=TrafficLightHandling, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
CheckForTrafficLights -> TrafficLightHandling;
StopPositionCalculationAction [label=StopPositionCalculationAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
TrafficLightHandling -> StopPositionCalculationAction;
HandleTrafficLightCycle [label=HandleTrafficLightCycle, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
TrafficLightHandling -> HandleTrafficLightCycle;
YellowLight [label=YellowLight, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
HandleTrafficLightCycle -> YellowLight;
Yellow [label=Yellow, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
YellowLight -> Yellow;
YellowLightDecision [label=YellowLightDecision, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
YellowLight -> YellowLightDecision;
YellowLightHandling [label=YellowLightHandling, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
YellowLight -> YellowLightHandling;
ComfortStopYellow [label=ComfortStopYellow, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
YellowLightHandling -> ComfortStopYellow;
BrakeAtYellowLight [label=BrakeAtYellowLight, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ComfortStopYellow -> BrakeAtYellowLight;
ComfortBrakingYellow [label=ComfortBrakingYellow, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ComfortStopYellow -> ComfortBrakingYellow;
NoStop [label=NoStop, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
YellowLightHandling -> NoStop;
ContinueDrivingAtYellowLight [label=ContinueDrivingAtYellowLight, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
NoStop -> ContinueDrivingAtYellowLight;
ContinueDrivingYellow [label=ContinueDrivingYellow, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
NoStop -> ContinueDrivingYellow;
PublishRVIZMarkerYellow [label=PublishRVIZMarkerYellow, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
YellowLight -> PublishRVIZMarkerYellow;
RedLight [label=RedLight, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
HandleTrafficLightCycle -> RedLight;
Red [label=Red, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
RedLight -> Red;
ComfortBrakingRed [label=ComfortBrakingRed, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
RedLight -> ComfortBrakingRed;
PublishRVIZMarkerRed [label=PublishRVIZMarkerRed, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
RedLight -> PublishRVIZMarkerRed;
GreenLight [label=GreenLight, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
HandleTrafficLightCycle -> GreenLight;
Green [label=Green, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
GreenLight -> Green;
ContinueDrivingGreen [label=ContinueDrivingGreen, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
GreenLight -> ContinueDrivingGreen;
PublishRVIZMarkerGreen [label=PublishRVIZMarkerGreen, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
GreenLight -> PublishRVIZMarkerGreen;
ErrorHandlingAction [label=ErrorHandlingAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
CheckForTrafficLights -> ErrorHandlingAction;
LateralClearanceVelocityAdjuster [label=LateralClearanceVelocityAdjuster, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
BehaviorModules -> LateralClearanceVelocityAdjuster;
LaneKeepingModule [label=LaneKeepingModule, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
BehaviorModules -> LaneKeepingModule;
LaneKeepingSequence [label=LaneKeepingSequence, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
LaneKeepingModule -> LaneKeepingSequence;
CheckForRestrictions [label=CheckForRestrictions, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
LaneKeepingSequence -> CheckForRestrictions;
BlackboardCondition [label=BlackboardCondition, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
CheckForRestrictions -> BlackboardCondition;
ROSCondition [label=ROSCondition, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
CheckForRestrictions -> ROSCondition;
ConfigCondition [label=ConfigCondition, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
CheckForRestrictions -> ConfigCondition;
ApplyLaneKeepingAction [label=ApplyLaneKeepingAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
LaneKeepingSequence -> ApplyLaneKeepingAction;
PublishRVIZMarkerLaneKeeping [label=PublishRVIZMarkerLaneKeeping, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
LaneKeepingSequence -> PublishRVIZMarkerLaneKeeping;
NoLaneKeepingSequence [label=NoLaneKeepingSequence, shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
LaneKeepingModule -> NoLaneKeepingSequence;
ApplyDefaultAction [label=ApplyDefaultAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
NoLaneKeepingSequence -> ApplyDefaultAction;
PublishRVIZMarkerNoLaneKeeping [label=PublishRVIZMarkerNoLaneKeeping, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
NoLaneKeepingSequence -> PublishRVIZMarkerNoLaneKeeping;
FailSafe [label=FailSafe, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
MainBehaviorTree -> FailSafe;
}
